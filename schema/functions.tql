# GUPI core functions (Phase 0 draft). Load with `define` on a fresh database; change with `redefine`.

define

  # Facts the system believed at transaction time $t: recorded by then, accepted by a review recorded
  # by then, and not superseded, rejected or retracted by anything recorded by then.
  # Phase 0 simplification: any rejection/retraction recorded by $t wins over a later re-acceptance.
  fun believed_at($t: datetime-tz) -> { fact }:
    match
      $f isa fact, has recorded-at $r; $r <= $t;
      review (reviewed: $f), has verdict "accepted", has recorded-at $ra; $ra <= $t;
      not { supersession (superseded: $f), has recorded-at $rs; $rs <= $t; };
      not { review (reviewed: $f), has verdict $v, has recorded-at $rv; $rv <= $t; $v != "accepted"; };
    return { $f };
